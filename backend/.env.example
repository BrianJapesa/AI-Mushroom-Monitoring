# Database: memory is a safe offline demo; choose firebase only after local setup is complete.
DB_BACKEND=memory
# Local web server port; loopback-only by default.
PORT=5000
# Local interface by default; public hosting must set the host required by its platform.
HOST=127.0.0.1
# Firebase Realtime Database URL; blank while using memory mode.
FIREBASE_URL=
# Local Admin SDK key path; never put the key file in Git or paste its contents into chat.
FIREBASE_CREDENTIALS=backend/secrets/serviceAccountKey.json

# API key: blank for loopback-only demo; use a client-owned random key on a shared network.
API_KEY=
# Comma-separated browser origins allowed to call the API; blank means no browser CORS origins.
CORS_ORIGINS=

# Oyster mushroom example targets; the farm must confirm before production alerts are enabled.
TEMP_MIN=22
TEMP_MAX=26
HUM_MIN=80
HUM_MAX=90
# Recovery distance above/below a threshold, to avoid repeated alerts from small changes.
RECOVERY_MARGIN_TEMP=1
RECOVERY_MARGIN_HUMIDITY=2
# Minimum seconds before the same alert type/room/severity may be raised again.
ALERT_COOLDOWN=600
# Raise an unresolved environmental alert to high after this many minutes.
ESCALATE_AFTER_MIN=30
# Alert when no sensor reading has arrived for this many minutes.
SENSOR_STALE_MIN=10

# Model and upload safety settings. No model is shipped in this prototype.
MAX_UPLOAD_MB=8
MIN_CONFIDENCE=0.55
# IANA time zone used for the farm's display and notification daily cap.
TIMEZONE=Africa/Nairobi
# Farm display name; confirm the wording with the client.
FARM_NAME=Japesa Farms
# Record cleanup is off at 0 days; set a positive period only after client review.
RETENTION_DAYS_RECORDS=0

# Optional email alerts. Use Gmail SMTP app-password authentication; values belong in backend/.env.
SMTP_HOST=smtp.gmail.com
# Use 465 with ssl, or 587 with starttls.
SMTP_PORT=465
SMTP_SECURITY=ssl
# Sender mailbox and app password; leave blank to disable email.
SMTP_USER=
SMTP_PASS=
# Human-readable name shown to recipients.
EMAIL_FROM_NAME=Japesa Farms Monitor
# Optional reply-to mailbox; blank uses no reply-to header.
EMAIL_REPLY_TO=
# Comma-separated recipient list; blank disables email delivery.
ALERT_EMAILS=
# Legacy single recipient setting; ALERT_EMAILS takes precedence when provided.
ALERT_EMAIL=
# Maximum successful alert/digest e-mails per farm-local day.
EMAIL_DAILY_CAP=100
# Alert language: en (English) or sw (Kiswahili, review wording before production).
ALERT_LANGUAGE=en
# Local dashboard link included in notification messages.
DASHBOARD_URL=http://127.0.0.1:5000/
# Optional Twilio SMS. Leave blank to disable SMS.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Comma-separated phone recipients in international E.164 format; blank disables SMS.
ALERT_PHONES=
# Legacy single recipient setting; ALERT_PHONES takes precedence when provided.
ALERT_PHONE=
