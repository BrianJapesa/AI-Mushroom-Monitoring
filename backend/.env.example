# Use memory for an offline demo. Set firebase only after local setup stores a service key.
DB_BACKEND=memory
FIREBASE_URL=
FIREBASE_CREDENTIALS=backend/secrets/serviceAccountKey.json

# Leave empty for a local classroom demo. Set a client-generated random key for a shared network.
API_KEY=
CORS_ORIGINS=

# Oyster mushroom room targets; confirm with the farm before production alerts.
TEMP_MIN=22
TEMP_MAX=26
HUM_MIN=80
HUM_MAX=90
RECOVERY_MARGIN_TEMP=1
RECOVERY_MARGIN_HUMIDITY=2
ALERT_COOLDOWN=600
ESCALATE_AFTER_MIN=30
SENSOR_STALE_MIN=10

# Model and upload safety settings.
MAX_UPLOAD_MB=8
MIN_CONFIDENCE=0.55
TIMEZONE=Africa/Nairobi

# Optional notification settings. Put real credentials in backend/.env only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Japesa Farms Monitor
EMAIL_REPLY_TO=
ALERT_EMAILS=
ALERT_EMAIL=
EMAIL_DAILY_CAP=100
ALERT_LANGUAGE=en
DASHBOARD_URL=http://127.0.0.1:5000/
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
ALERT_PHONES=
ALERT_PHONE=
